;; Honest Kotoba v1 ADIOS2/BP binding: identification fields only.
;;
;; The parse functions take the header bytes as input and derive every field
;; from them. Kotoba CLI v0.7.3 wasm32 is i64-only (no IEEE floats, no
;; nonempty bytes builtin), so the header is passed as little-endian i64
;; words: w0 = bytes 0-7, w4 = bytes 32-39. That covers every field below.
;; Other bytes of the 64-byte header (VersionTag tail, library digits, UUID,
;; padding) are not parsed.
;;
;; Vendored fixture bytes (hex): 4144494f532d42502076322e312e3020496e646578205461626c65000000000032313000000502006e0004030201000000000000000000000000000000000000
;; Identification fields from source/adios2/engine/bp5/BP5Engine.h:
;;   bytes  0-7  magic "ADIOS-BP"
;;   byte     36 endianness (0 little, 1 big)
;;   byte     37 BP version (5)
;;   byte     38 BP minor version (2)
;;   byte     39 active flag
;; Owner constraint: magic/header or one record. No I/O engine, no BP writer,
;; no timestep/query. i64-v1, wasm32, no FFI, no IEEE floats.

(ns adios2.header
  (:export [main
            header-len word-byte header-byte
            magic-ok endian-flag little-endian? bp-version bp-minor active-flag
            pack
            fixture-w0 fixture-w4]))

(defn header-len [] :i64 64)

;; fixtures/bp5-index-header.bin packed as little-endian i64 words.
;; kotoba/run_wasm.mjs re-packs the fixture file and fails if these drift.
(defn fixture-w0 [] :i64 5783234707332875329)
(defn fixture-w4 [] :i64 568447514718514)

(defn p256 [p :i64] :i64
  (if (< p 1) 1
    (if (< p 2) 256
      (if (< p 3) 65536
        (if (< p 4) 16777216
          (if (< p 5) 4294967296
            (if (< p 6) 1099511627776
              (if (< p 7) 281474976710656
                72057594037927936))))))))

;; Byte p (0-7) of a non-negative little-endian i64 word. A word whose top
;; byte is >= 0x80 is negative in i64 and is rejected by the callers below.
(defn word-byte [word :i64 p :i64] :i64
  (let [q (quot word (p256 p))]
    (- q (* (quot q 256) 256))))

;; Header byte i from words w0 (bytes 0-7) and w4 (bytes 32-39).
;; Returns -1 for an offset this binding does not parse.
(defn header-byte [w0 :i64 w4 :i64 i :i64] :i64
  (if (< i 0)
    -1
    (if (< i 8)
      (word-byte w0 i)
      (if (< i 32)
        -1
        (if (< i 40)
          (word-byte w4 (- i 32))
          -1)))))

;; "ADIOS-BP" = 65 68 73 79 83 45 66 80.
(defn magic-ok [w0 :i64] :i64
  (if (and (>= w0 0)
           (and (= (word-byte w0 0) 65)
                (and (= (word-byte w0 1) 68)
                     (and (= (word-byte w0 2) 73)
                          (and (= (word-byte w0 3) 79)
                               (and (= (word-byte w0 4) 83)
                                    (and (= (word-byte w0 5) 45)
                                         (and (= (word-byte w0 6) 66)
                                              (= (word-byte w0 7) 80)))))))))
    1
    0))

(defn endian-flag [w4 :i64] :i64 (word-byte w4 4))
(defn bp-version [w4 :i64] :i64 (word-byte w4 5))
(defn bp-minor [w4 :i64] :i64 (word-byte w4 6))
(defn active-flag [w4 :i64] :i64 (word-byte w4 7))

(defn little-endian? [w4 :i64] :i64
  (if (= (endian-flag w4) 0) 1 0))

;; Packed identification fields, or 0 when the header is not a BP5 index
;; header (bad magic, negative w4, or BP major version other than 5).
(defn pack [w0 :i64 w4 :i64] :i64
  (if (and (= (magic-ok w0) 1)
           (and (>= w4 0)
                (= (bp-version w4) 5)))
    (+ (* (magic-ok w0) 100000)
       (+ (* (little-endian? w4) 10000)
          (+ (* (bp-version w4) 100)
             (+ (* (bp-minor w4) 10)
                (active-flag w4)))))
    0))

(defn main [] :i64
  (pack (fixture-w0) (fixture-w4)))
